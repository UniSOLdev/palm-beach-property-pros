# Supabase — palm-beach-property-pros project
NEXT_PUBLIC_SUPABASE_URL=https://pfojtrfkeoeymmtkvijo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only — required for /quote photo uploads; RPC fallback works without it for lead insert
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — direct Postgres for local db:push (Supabase CLI uses linked project instead)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Public site URL — used for quote/invoice/signing links (production)
NEXT_PUBLIC_SITE_URL=https://www.palmbeachpropertypros.com

# ---------------------------------------------------------------------------
# Autopilot — FREE TIER FIRST (default: $0/mo beyond hosting)
# ---------------------------------------------------------------------------
# Tier: "free" (default) = tasks + email only | "paid" = unlock SMS, Stripe, OpenAI when keys set
AUTOPILOT_TIER=free

# Cron auth — cron-job.org (free). Run: npm run cron:setup
CRON_SECRET=generate_a_long_random_secret
ALLOW_DEV_CRON=true

# Email — Resend FREE tier: 100 emails/day (enough for PBPP)
# Sign up: https://resend.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=hello@palmbeachpropertypros.com

# Weekly digest recipient (defaults to RESEND_FROM_EMAIL if unset)
# AUTOPILOT_DIGEST_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# PAID TIER ONLY — leave unset on free tier
# ---------------------------------------------------------------------------

# Receipt scanner — OpenAI Vision (optional, separate from autopilot copy)
# OPENAI_API_KEY=your_openai_api_key

# SMS + voice receptionist — Twilio (~$30+/mo). Set AUTOPILOT_TIER=paid first.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+15616292617
# TWILIO_WEBHOOK_BASE_URL=https://www.palmbeachpropertypros.com

# Online payments — Stripe (pay per transaction only). Set AUTOPILOT_TIER=paid first.
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
